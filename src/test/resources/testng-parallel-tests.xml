<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
    TestNG XML Configuration for Parallel Execution (by tests/classes)

    This runs each test class in a separate thread.
    Each test class gets its own WebDriver instance via ThreadLocal.
-->

<suite name="Parallel Tests - By Classes" parallel="tests" thread-count="3">

    <test name="Shopping Cart Test Class">
        <classes>
            <class name="com.periplus.tests.ShoppingCartTest"/>
        </classes>
    </test>

    <!-- Add more test classes here as needed -->
    <!--
